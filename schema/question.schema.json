{
  "$id": "https://fmfalgun.github.io/gate-library/api/v1/schema/question.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "patternProperties": {
    "^x_": {}
  },
  "properties": {
    "answer": {
      "oneOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        {
          "additionalProperties": false,
          "properties": {
            "max": {
              "type": "number"
            },
            "min": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "type": "object"
        }
      ]
    },
    "attempts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "date": {
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "type": "string"
          },
          "reason": {
            "enum": [
              "concept",
              "calculation",
              "trap",
              "time",
              "misread"
            ]
          },
          "result": {
            "enum": [
              "right",
              "wrong",
              "skipped"
            ]
          }
        },
        "required": [
          "date",
          "result"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "created": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "exam": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "minimum": 1,
          "type": "integer"
        },
        "paper": {
          "minLength": 1,
          "type": "string"
        },
        "session": {
          "minimum": 1,
          "type": "integer"
        },
        "year": {
          "type": "integer"
        }
      },
      "required": [
        "year",
        "paper",
        "session",
        "number"
      ],
      "type": "object"
    },
    "fastest_method": {
      "minLength": 1,
      "type": "string"
    },
    "kind": {
      "const": "question"
    },
    "marks": {
      "enum": [
        1,
        2
      ]
    },
    "options": {
      "additionalProperties": false,
      "patternProperties": {
        "^[A-D]$": {
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "origin": {
      "enum": [
        "pyq",
        "generated"
      ]
    },
    "show_on": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "slug": {
      "minLength": 1,
      "type": "string"
    },
    "solution": {
      "minLength": 1,
      "type": "string"
    },
    "source_url": {
      "pattern": "^https?://",
      "type": "string"
    },
    "stem": {
      "minLength": 1,
      "type": "string"
    },
    "topics": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "trap": {
      "minLength": 1,
      "type": "string"
    },
    "type": {
      "enum": [
        "mcq",
        "msq",
        "nat"
      ]
    },
    "updated": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    }
  },
  "required": [
    "slug",
    "kind",
    "origin",
    "type",
    "marks",
    "topics",
    "stem",
    "answer",
    "solution",
    "created",
    "updated"
  ],
  "type": "object"
}
