{
  "$id": "https://fmfalgun.github.io/gate-library/api/v1/schema/topic.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "patternProperties": {
    "^x_": {}
  },
  "properties": {
    "confidence": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    },
    "created": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "kind": {
      "const": "topic"
    },
    "prerequisites": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "related": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "show_on": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "slug": {
      "minLength": 1,
      "type": "string"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "pattern": "^https?://",
            "type": "string"
          }
        },
        "required": [
          "label",
          "url"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {
      "enum": [
        "learning",
        "revised",
        "exam-ready"
      ]
    },
    "summary": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
    },
    "syllabus": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "tags": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "title": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
    },
    "updated": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "xrefs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "slug",
    "kind",
    "title",
    "summary",
    "syllabus",
    "status",
    "confidence",
    "created",
    "updated"
  ],
  "type": "object"
}
