#!/usr/bin/env bash
# Pre-commit hook: keeps secrets out of this public repo, then validates the
# content and regenerates api/v1 so generated files land in the same commit.
# Needs git, grep and Python 3.11+ with requirements.txt installed (a .venv is used if present). gitleaks is used when installed
# (project-local .tools/bin first, then PATH); a missing gitleaks is a note.
# Activate with: git config core.hooksPath ci/hooks

set -euo pipefail

# Staged paths with these names or extensions are always refused.
readonly FORBIDDEN_NAME_PATTERN='(\.pem|\.key|\.p12|\.pfx|\.jks|_sk)$|(^|/)id_(rsa|ed25519|ecdsa)|(^|/)\.env($|\.)'

# A PEM private-key header inside any staged file is refused.
readonly PRIVATE_KEY_PATTERN='BEGIN [A-Z ]*PRIVATE KEY'

# repo_root prints the repository being committed to.
repo_root() {
  git rev-parse --show-toplevel
}

# list_staged_files prints each added, copied, modified or renamed staged
# path on its own line. Deleted files are skipped: removing a key is fine.
list_staged_files() {
  git diff --cached --name-only --diff-filter=ACMR
}

# is_refused succeeds when the staged file ($1) has a key-like name or a
# private-key header. It reads the index, so what is checked is exactly what
# would be committed. On refusal it prints the reason on stderr.
is_refused() {
  local path="$1"
  if [[ "$path" =~ $FORBIDDEN_NAME_PATTERN && "$path" != *.env.example ]]; then
    echo "pre-commit: refusing '$path' (key or env file name)" >&2
    return 0
  fi
  if git show ":$path" | grep -aqE "$PRIVATE_KEY_PATTERN"; then
    echo "pre-commit: refusing '$path' (contains a private key)" >&2
    return 0
  fi
  return 1
}

# find_gitleaks prints the gitleaks binary to use: the project-local one
# first, then any on PATH. It prints nothing when gitleaks is not installed.
find_gitleaks() {
  local local_bin
  local_bin="$(repo_root)/.tools/bin/gitleaks"
  if [[ -x "$local_bin" ]]; then
    echo "$local_bin"
  else
    command -v gitleaks || true
  fi
}

# run_gitleaks scans the staged changes and succeeds when nothing is found.
# A missing gitleaks is only a note, so a fresh clone can still commit.
run_gitleaks() {
  local binary
  binary="$(find_gitleaks)"
  if [[ -z "$binary" ]]; then
    echo "pre-commit: gitleaks not installed; skipping token scan" >&2
    return 0
  fi
  "$binary" git --pre-commit --staged --redact --no-banner
}

# run_no_force_check greps the repo scripts for force-based commands.
run_no_force_check() {
  "$(repo_root)/ci/check-no-force.sh"
}

# find_python prints the interpreter to use: the project venv (which has the
# pinned requirements) first, then python3 on PATH. Prints nothing if neither exists.
find_python() {
  local venv_python
  venv_python="$(repo_root)/.venv/bin/python"
  if [[ -x "$venv_python" ]]; then
    echo "$venv_python"
  else
    command -v python3 || true
  fi
}

# run_sync validates the content, rewrites api/v1 and the README rule list,
# and stages them. A failed validation blocks the commit.
run_sync() {
  local interpreter
  interpreter="$(find_python)"
  if [[ -z "$interpreter" ]]; then
    echo "pre-commit: no python found; cannot validate content" >&2
    return 1
  fi
  "$interpreter" "$(repo_root)/ci/sync_index.py" || return 1
  git add api README.md
}

# main checks every staged file and exits 1 if any check failed.
main() {
  local path refused=0
  while IFS= read -r path; do
    if is_refused "$path"; then refused=1; fi
  done < <(list_staged_files)
  run_gitleaks || refused=1
  run_no_force_check || refused=1
  run_sync || refused=1
  if (( refused )); then
    echo "pre-commit: commit blocked. Fix the findings above; never bypass this hook." >&2
  fi
  return "$refused"
}

main "$@"
